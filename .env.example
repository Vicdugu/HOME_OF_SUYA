# ─── Database ────────────────────────────────────────────────
# Neon PostgreSQL (with malam_suya schema)
DATABASE_URL="postgresql://neondb_owner:npg_YDSEuZIzx51M@ep-still-waterfall-apzsltud-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&schema=malam_suya"

# ─── Admin Auth ──────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -hex 32"
NEXTAUTH_URL="https://your-domain.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password"

# ─── SumUp ───────────────────────────────────────────────────
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""
# Optional OAuth-based SumUp setup
SUMUP_CLIENT_ID=""
SUMUP_CLIENT_SECRET=""
SUMUP_OAUTH_REDIRECT_URI="https://your-domain.com/api/sumup/oauth/callback"

# ─── Meta WhatsApp Cloud API ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
ADMIN_WHATSAPP_NUMBER=""          # e.g. 447700000000 (no + prefix)

# ─── Resend (admin notifications — optional) ─────────────────
RESEND_API_KEY=""
ADMIN_EMAIL=""
FROM_EMAIL="noreply@yourdomain.com"

# ─── Cloudinary (meal image uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
# CUSTOMER_EMAIL_ENABLED="true"   # uncomment to activate customer emails

# ─── Security: Phase 1 - JWT & Token Security ─────────────────
# Webhook signature verification
SUMUP_WEBHOOK_SECRET="generate-with: openssl rand -hex 32"

# ─── Security: Phase 2 - Encryption & Advanced Security ───────
# AES-256-GCM Encryption Key (32 bytes hex)
ENCRYPTION_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token-here"

# ─── Security: Phase 3 - Advanced Access Control ──────────────
# MFA/2FA Configuration
MFA_REQUIRED="false"
MFA_WINDOW="1"
MFA_BACKUP_CODES_COUNT="10"

# ─── Security: Phase 4 - Input Validation & Infrastructure ────
# Input validation settings
MAX_REQUEST_BODY_SIZE="10mb"
STRICT_INPUT_VALIDATION="true"
DISABLE_TRACE="true"
# Infrastructure security
NODE_ENV="production"
DEBUG="false"
ENABLE_SECURITY_HEADERS="true"
CORS_ALLOWED_ORIGINS="https://your-domain.com"
# Data retention policies
RATE_LIMIT_WINDOW="900000"
SECURITY_EVENT_RETENTION_DAYS="30"
AUDIT_LOG_RETENTION_DAYS="90"

