# ─── Database ────────────────────────────────────────────────
# Neon PostgreSQL (with malam_suya schema)
DATABASE_URL="postgresql://USER:PASS@HOST/neondb?channel_binding=require&sslmode=require&schema=malam_suya"

# ─── Admin Auth ──────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -hex 32"
NEXTAUTH_URL="https://your-domain.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password"

# ─── SumUp ───────────────────────────────────────────────────
SUMUP_API_KEY=""
SUMUP_MERCHANT_EMAIL=""

# ─── Stripe (fallback) ───────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ─── Meta WhatsApp Cloud API ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
ADMIN_WHATSAPP_NUMBER=""          # e.g. 447700000000 (no + prefix)

# ─── Resend (admin notifications — optional) ─────────────────
RESEND_API_KEY=""
ADMIN_EMAIL=""
FROM_EMAIL="noreply@yourdomain.com"

# ─── Cloudinary (meal image uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
# CUSTOMER_EMAIL_ENABLED="true"   # uncomment to activate customer emails
